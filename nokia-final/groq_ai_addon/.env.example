# Groq credentials are used by the addon backend only.
GROQ_API_KEYS=
# For key failover on HTTP 429, set GROQ_API_KEYS instead, as a comma-separated
# list. Never commit real keys or paste them into chat.
# GROQ_API_KEYS=replace_with_key_one,replace_with_key_two
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=90

# Existing Secure Access API. For a Windows-hosted addon with the API in WSL,
# use the current WSL host gateway address instead of Windows loopback.
SECURE_ACCESS_API_URL=http://172.25.112.1:8765
SECURE_ACCESS_TIMEOUT_SECONDS=15
WARPGATE_URL=https://localhost:8888
# Leave blank when Warpgate's certificate chains to a trusted system CA.
# Otherwise set the absolute path to the trusted CA bundle (not a private key).
WARPGATE_CA_BUNDLE=
APP_TIMEZONE=Asia/Kolkata

# Optional. Configure only a dedicated PostgreSQL account granted SELECT on
# incidents. There is no default and the addon never reads the app DB password.
AUDIT_DATABASE_URL=
AUDIT_QUERY_TIMEOUT_SECONDS=5
